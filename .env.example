# Resend — set these in Vercel Project → Settings → Environment Variables too
RESEND_API_KEY=re_xxxxxxxx
RESEND_TO_EMAIL=consultations@kianprive.com
# Until your domain is verified in Resend, use: KIAN Privé <onboarding@resend.dev>
RESEND_FROM_EMAIL=KIAN Privé <onboarding@resend.dev>

# Forward Provider Connect intakes into KIAN Privé Clinical Intake
# Production API (no trailing slash)
KIAN_PRIVE_API_URL=https://www.kianprive.com
# Must match WELLNESS_HUB_INTAKE_SECRET on the kianprive project
KIAN_PRIVE_INTAKE_SECRET=generate-a-long-random-string

# Local docker/dev example:
# KIAN_PRIVE_API_URL=http://localhost:3005
